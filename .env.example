# Copy to .env and fill in
PORT=3000
# Set to 1 when running behind nginx with HTTPS (enables secure cookies)
BEHIND_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hoptone
DB_PASSWORD=change-me
DB_NAME=hoptone_portal

# Long random string: openssl rand -hex 32
SESSION_SECRET=change-me

# Bearer token for the read-only blocklist API used by your call-blocking system.
# Leave empty to disable the API. Generate with: openssl rand -hex 32
API_KEY=
